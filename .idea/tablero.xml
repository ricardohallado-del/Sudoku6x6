<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sudoku6x6.ControladorSudoku"
            style="-fx-background-color: #1a1a2e;"
            prefWidth="520" prefHeight="620">

    <!-- ===== TÍTULO ===== -->
    <top>
        <VBox alignment="CENTER" style="-fx-padding: 20 0 10 0;">
            <Label text="SUDOKU 6×6"
                   style="-fx-text-fill: #e0e0ff;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Segoe UI';
                          -fx-letter-spacing: 4px;"/>
            <Label fx:id="etiquetaPistas"
                   text="Pistas disponibles: 6"
                   style="-fx-text-fill: #a0a0cc;
                          -fx-font-size: 13px;
                          -fx-font-family: 'Segoe UI';"/>
        </VBox>
    </top>

    <!-- ===== CUADRÍCULA 6x6 ===== -->
    <center>
        <VBox alignment="CENTER" spacing="0">
            <padding><Insets top="5" bottom="5" left="20" right="20"/></padding>

            <!--
                ESTRUCTURA DE BLOQUES 2x3:
                El tablero 6x6 tiene 6 bloques de 2 filas x 3 columnas.
                Los separamos visualmente agrupando filas de a 2 en HBox,
                y columnas de a 3 dentro de cada HBox.

                Cada TextField tiene fx:id="c_FILA_COL" (fila y col de 0 a 5).
                El controlador los cargará por ese fx:id.
            -->

            <!-- FILA DE BLOQUES 0 y 1 (filas 0-1) -->
            <HBox spacing="0" alignment="CENTER">
                <!-- BLOQUE 0: filas 0-1, cols 0-2 -->
                <GridPane style="-fx-border-color: #5555aa; -fx-border-width: 2px; -fx-background-color: #16213e;">
                    <!-- Fila 0 -->
                    <TextField fx:id="c_0_0" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_0_1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_0_2" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <!-- Fila 1 -->
                    <TextField fx:id="c_1_0" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_1_1" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_1_2" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="65"/>
                        <RowConstraints prefHeight="65"/>
                    </rowConstraints>
                </GridPane>

                <!-- BLOQUE 1: filas 0-1, cols 3-5 -->
                <GridPane style="-fx-border-color: #5555aa; -fx-border-width: 2px; -fx-background-color: #16213e;" GridPane.columnIndex="1">
                    <!-- Fila 0 -->
                    <TextField fx:id="c_0_3" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_0_4" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_0_5" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <!-- Fila 1 -->
                    <TextField fx:id="c_1_3" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_1_4" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_1_5" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="65"/>
                        <RowConstraints prefHeight="65"/>
                    </rowConstraints>
                </GridPane>
            </HBox>

            <!-- FILA DE BLOQUES 2 y 3 (filas 2-3) -->
            <HBox spacing="0" alignment="CENTER">
                <!-- BLOQUE 2: filas 2-3, cols 0-2 -->
                <GridPane style="-fx-border-color: #5555aa; -fx-border-width: 2px; -fx-background-color: #16213e;">
                    <TextField fx:id="c_2_0" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_2_1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_2_2" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="c_3_0" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_3_1" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_3_2" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="65"/>
                        <RowConstraints prefHeight="65"/>
                    </rowConstraints>
                </GridPane>

                <!-- BLOQUE 3: filas 2-3, cols 3-5 -->
                <GridPane style="-fx-border-color: #5555aa; -fx-border-width: 2px; -fx-background-color: #16213e;">
                    <TextField fx:id="c_2_3" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_2_4" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_2_5" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="c_3_3" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_3_4" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_3_5" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="65"/>
                        <RowConstraints prefHeight="65"/>
                    </rowConstraints>
                </GridPane>
            </HBox>

            <!-- FILA DE BLOQUES 4 y 5 (filas 4-5) -->
            <HBox spacing="0" alignment="CENTER">
                <!-- BLOQUE 4: filas 4-5, cols 0-2 -->
                <GridPane style="-fx-border-color: #5555aa; -fx-border-width: 2px; -fx-background-color: #16213e;">
                    <TextField fx:id="c_4_0" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_4_1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_4_2" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="c_5_0" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_5_1" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_5_2" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="65"/>
                        <RowConstraints prefHeight="65"/>
                    </rowConstraints>
                </GridPane>

                <!-- BLOQUE 5: filas 4-5, cols 3-5 -->
                <GridPane style="-fx-border-color: #5555aa; -fx-border-width: 2px; -fx-background-color: #16213e;">
                    <TextField fx:id="c_4_3" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_4_4" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_4_5" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="c_5_3" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="c_5_4" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="c_5_5" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                        <ColumnConstraints prefWidth="70"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="65"/>
                        <RowConstraints prefHeight="65"/>
                    </rowConstraints>
                </GridPane>
            </HBox>

        </VBox>
    </center>

    <!-- ===== BOTONES ===== -->
    <bottom>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="15" bottom="20" left="20" right="20"/></padding>

            <!-- Fila 1: Nuevo Juego y Ayuda -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="botonNuevoJuego"
                        text="🎲  Nuevo Juego"
                        onAction="#nuevoJuego"
                        prefWidth="185" prefHeight="42"
                        style="-fx-background-color: #4444aa;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-family: 'Segoe UI';
                               -fx-font-weight: bold;
                               -fx-background-radius: 8px;
                               -fx-cursor: hand;"/>

                <Button fx:id="botonAyuda"
                        text="💡  Pista"
                        onAction="#usarPista"
                        prefWidth="185" prefHeight="42"
                        style="-fx-background-color: #aa8800;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-family: 'Segoe UI';
                               -fx-font-weight: bold;
                               -fx-background-radius: 8px;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- Fila 2: Reiniciar -->
            <HBox alignment="CENTER">
                <Button fx:id="botonReiniciar"
                        text="🔄  Reiniciar"
                        onAction="#reiniciarTablero"
                        prefWidth="385" prefHeight="38"
                        style="-fx-background-color: #333355;
                               -fx-text-fill: #a0a0cc;
                               -fx-font-size: 13px;
                               -fx-font-family: 'Segoe UI';
                               -fx-background-radius: 8px;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
