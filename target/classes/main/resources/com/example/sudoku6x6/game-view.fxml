<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane onKeyPressed="#onKeyboard" prefHeight="660" prefWidth="620" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sudoku6x6.Controllers.GameController">

    <!-- ═══ TOP BAR ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
            <Button onAction="#onBackMenu" styleClass="btn-back" text="← Menú" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label styleClass="top-title" text="Sudoku ------------- 6X6" />
            <HBox HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER" spacing="2" />
        </HBox>
    </top>

    <!-- ═══ CENTER: tablero + panel lateral ═══ -->
    <center>
        <HBox alignment="CENTER" spacing="0">

            <!-- TABLERO CENTRADO -->
            <StackPane alignment="CENTER" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                <GridPane alignment="CENTER" hgap="0" styleClass="board-grid" vgap="0">

                    <!-- FILA 0 -->
                    <StackPane fx:id="c00" styleClass="cell-normal" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c01" styleClass="cell-normal" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c02" styleClass="cell-normal,block-border-right" GridPane.columnIndex="2" GridPane.rowIndex="0"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c03" styleClass="cell-normal" GridPane.columnIndex="3" GridPane.rowIndex="0"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c04" styleClass="cell-normal" GridPane.columnIndex="4" GridPane.rowIndex="0"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c05" styleClass="cell-normal" GridPane.columnIndex="5" GridPane.rowIndex="0"><Label styleClass="cell-label" /></StackPane>
                    <!-- FILA 1 -->
                    <StackPane fx:id="c10" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c11" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c12" styleClass="cell-normal,block-border-right,block-border-bottom" GridPane.columnIndex="2" GridPane.rowIndex="1"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c13" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="3" GridPane.rowIndex="1"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c14" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="4" GridPane.rowIndex="1"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c15" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="5" GridPane.rowIndex="1"><Label styleClass="cell-label" /></StackPane>
                    <!-- FILA 2 -->
                    <StackPane fx:id="c20" styleClass="cell-normal" GridPane.columnIndex="0" GridPane.rowIndex="2"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c21" styleClass="cell-normal" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c22" styleClass="cell-normal,block-border-right" GridPane.columnIndex="2" GridPane.rowIndex="2"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c23" styleClass="cell-normal" GridPane.columnIndex="3" GridPane.rowIndex="2"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c24" styleClass="cell-normal" GridPane.columnIndex="4" GridPane.rowIndex="2"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c25" styleClass="cell-normal" GridPane.columnIndex="5" GridPane.rowIndex="2"><Label styleClass="cell-label" /></StackPane>
                    <!-- FILA 3 -->
                    <StackPane fx:id="c30" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="0" GridPane.rowIndex="3"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c31" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="1" GridPane.rowIndex="3"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c32" styleClass="cell-normal,block-border-right,block-border-bottom" GridPane.columnIndex="2" GridPane.rowIndex="3"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c33" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="3" GridPane.rowIndex="3"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c34" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="4" GridPane.rowIndex="3"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c35" styleClass="cell-normal,block-border-bottom" GridPane.columnIndex="5" GridPane.rowIndex="3"><Label styleClass="cell-label" /></StackPane>
                    <!-- FILA 4 -->
                    <StackPane fx:id="c40" styleClass="cell-normal" GridPane.columnIndex="0" GridPane.rowIndex="4"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c41" styleClass="cell-normal" GridPane.columnIndex="1" GridPane.rowIndex="4"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c42" styleClass="cell-normal,block-border-right" GridPane.columnIndex="2" GridPane.rowIndex="4"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c43" styleClass="cell-normal" GridPane.columnIndex="3" GridPane.rowIndex="4"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c44" styleClass="cell-normal" GridPane.columnIndex="4" GridPane.rowIndex="4"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c45" styleClass="cell-normal" GridPane.columnIndex="5" GridPane.rowIndex="4"><Label styleClass="cell-label" /></StackPane>
                    <!-- FILA 5 -->
                    <StackPane fx:id="c50" styleClass="cell-normal" GridPane.columnIndex="0" GridPane.rowIndex="5"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c51" styleClass="cell-normal" GridPane.columnIndex="1" GridPane.rowIndex="5"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c52" styleClass="cell-normal,block-border-right" GridPane.columnIndex="2" GridPane.rowIndex="5"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c53" styleClass="cell-normal" GridPane.columnIndex="3" GridPane.rowIndex="5"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c54" styleClass="cell-normal" GridPane.columnIndex="4" GridPane.rowIndex="5"><Label styleClass="cell-label" /></StackPane>
                    <StackPane fx:id="c55" styleClass="cell-normal" GridPane.columnIndex="5" GridPane.rowIndex="5"><Label styleClass="cell-label" /></StackPane>
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>
            </StackPane>

            <!-- PANEL LATERAL: solo estado + ayuda -->
            <VBox prefWidth="165" spacing="0" styleClass="side-panel">
                <padding><Insets bottom="20" left="14" right="14" top="20" /></padding>
                <Label styleClass="section-header" text="ESTADO" />
                <VBox prefHeight="76.0" prefWidth="106.0" spacing="4" styleClass="status-box">
                    <padding><Insets bottom="10" top="8" /></padding>
                    <Label fx:id="lblStatus" prefHeight="67.0" prefWidth="90.0" styleClass="status-text" text="Selecciona un cuadro" wrapText="true" />
                    <Label styleClass="status-hint" wrapText="true" />
                </VBox>
                <Separator styleClass="divider" />
                <Label styleClass="section-header" text="AYUDA" />
                <VBox spacing="8">
                    <padding><Insets top="8" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="hint-label" text="Disponibles:" />
                        <Label fx:id="lblAyudas" styleClass="hint-count" text="3">
                     <font>
                        <Font size="6.0" />
                     </font></Label>
                    </HBox>
                    <Button fx:id="btnAyuda" onAction="#onHelps" prefHeight="38" prefWidth="137" styleClass="btn-hint" text="💡  Ayuda">
                  <font>
                     <Font name="Bauhaus 93" size="12.0" />
                  </font></Button>
                </VBox>
            </VBox>

        </HBox>
    </center>

    <!-- ═══ BOTTOM: botones de partida centrados ═══ -->
    <bottom>
        <HBox alignment="CENTER" spacing="16" styleClass="bottom-bar">
            <padding><Insets bottom="14" left="24" right="24" top="14" /></padding>
            <Button onAction="#onRestart" prefHeight="40" prefWidth="180" styleClass="btn-secondary" text="Reiniciar Partida" />
            <Button onAction="#onNewPlayer" prefHeight="40" prefWidth="200" styleClass="btn-primary" text="＋  Nuevo Juego" />
        </HBox>
    </bottom>

</BorderPane>
